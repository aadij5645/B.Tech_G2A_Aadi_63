#include<stdio.h>
int main()
{
    int n, d, s=0, i;
    printf("Enter any number\n");
    scanf("%d",&n);
    i=n;
    while(i!=0)
    {
        d=i%10;
        s+=d*d*d;
        i=i/10;
    }
    if(s==n)
    printf("The entered number is an armstrong number");
    else
    printf("The entered numbber is not an armstrong number");
}
