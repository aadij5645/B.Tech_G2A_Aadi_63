#include<stdio.h>
#include<math.h>
int main()
{
    long long binary;
    int decimal=0, remainder, i=0;
    printf("Enter any number in binary\n");
    scanf("%lld",&binary);
    while(binary!=0)
    {
        remainder = binary%10;
        decimal = decimal + remainder * pow(2,i);
        binary = binary/10;
        i++;
    }
    printf("The number in decimal is %d",decimal);
}
