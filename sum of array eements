#include<stdio.h>
int main()
{
    int a[100], sum=0, n;
    printf("Enter limit of the array\n");
    scanf("%d",&n);
    printf("Enter elements of array\n");
    for(int i=0; i<n; i++)
    {
        scanf("%d",&a[i]);
    }
    for(int i=0; i<n; i++)
    {
        sum+=a[i];
    }
    printf("Sum of the elements of array is %d",sum);
} 
