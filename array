#include<stdio.h>
int main()
{
    int a[100], n;
    printf("Enter actual limit of the array\n");
    scanf("%d",&n);
    printf("Enter elements of the array\n");
    for(int i =0; i<n; i++)
    {
        scanf("%d",&a[i]);
    }
    printf("The elements of the array are\n");
    for(int i=0; i<n; i++)
    {
        printf("%d\t",a[i]);
    }
}
